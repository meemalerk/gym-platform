{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, gym_id, event_type, payload, occurred_at, attempts\n        FROM domain_events\n        WHERE processed_at IS NULL\n          AND attempts < $3\n          AND (next_attempt_at IS NULL OR next_attempt_at <= $2)\n        ORDER BY occurred_at\n        LIMIT $1\n        FOR UPDATE SKIP LOCKED\n        ",
