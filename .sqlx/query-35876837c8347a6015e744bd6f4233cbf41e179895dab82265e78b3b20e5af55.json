  "query": "\n            SELECT user_id, measured_on, weight_kg, body_fat_percent,\n                   waist_cm, hip_cm, chest_cm, arm_cm, thigh_cm, notes\n            FROM body_measurements\n            WHERE user_id = $1\n            ORDER BY measured_on DESC\n            LIMIT 365\n            ",
