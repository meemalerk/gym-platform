  "query": "\n            SELECT t.id, t.week_id, t.day_number, t.name, t.notes\n            FROM workout_templates t\n            JOIN program_weeks w ON w.id = t.week_id\n            WHERE t.gym_id = $1 AND w.version_id = $2\n            ORDER BY w.week_number, t.day_number\n            ",
