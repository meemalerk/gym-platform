{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT c.id, c.member_id, c.scanned_by, c.allowed, c.reason, c.scanned_at,\n                   u.display_name AS member_name\n            FROM gym_checkins c\n            JOIN users u ON u.id = c.member_id\n            WHERE c.gym_id = $1\n            ORDER BY c.scanned_at DESC, c.id DESC\n            LIMIT 50\n            ",
