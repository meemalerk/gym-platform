{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT a.id, a.action, a.entity_type, a.entity_id, a.metadata,\n                   a.occurred_at, u.display_name AS \"actor_name?\"\n            FROM audit_log a\n            LEFT JOIN users u ON u.id = a.actor_id\n            WHERE a.gym_id = $1\n            ORDER BY a.occurred_at DESC, a.id DESC\n            LIMIT $2\n            ",
