  "query": "\n            SELECT b.member_id, u.display_name\n            FROM class_bookings b\n            JOIN users u ON u.id = b.member_id\n            WHERE b.gym_id = $1 AND b.class_id = $2 AND b.on_date = $3\n              AND b.cancelled_at IS NULL\n            ORDER BY u.display_name, b.member_id\n            ",
