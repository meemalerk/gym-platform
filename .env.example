# Copy to .env for local development. NEVER commit .env.
# Production secrets come from the deployment environment / secret manager.

# Privileged role — used ONLY to run migrations at boot.
DATABASE_URL=postgres://gym:gym_dev_password@localhost:5455/gym

# Runtime role. MUST NOT be the table owner: Postgres bypasses row-level
# security for owners and superusers, so using the owner here silently disables
# every tenant-isolation policy. Created by the RLS migration.
APP_DATABASE_URL=postgres://gym_app:gym_app_dev_password@localhost:5455/gym

DATABASE_MAX_CONNECTIONS=10

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Signing key for short-lived access tokens.
# Generate a real one per environment:  openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-real-deployment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API (comma-separated, exact match).
# Empty = no cross-origin access, which is correct for a native-only deployment;
# native apps are not subject to CORS. Never use a wildcard here.
# Example for local web development:
# CORS_ALLOWED_ORIGINS=http://localhost:8212,http://localhost:5173
CORS_ALLOWED_ORIGINS=

RUST_LOG=info,gym_api=debug,gym_infrastructure=debug,tower_http=debug

# Caps `gyms` at one row (ADR-0023). Left off for local dev: the verification
# suite (scripts/verify-rls.sh) deliberately
# create several gyms to prove tenant isolation. A real single-gym deployment
# sets this explicitly — see docker-compose.demo.yml.
SINGLE_GYM_MODE=false

# ---------------------------------------------------------------- payments
# The payment gateway behind ADR-0010's seam. Three states, and the server
# picks in this order:
#
#   PAYMENT_GATEWAY=dummy   a built-in fake card page, served by this API.
#                           No account, no keys, no network. This is the
#                           default for local dev and the demo, so "pay this
#                           invoice" is a thing you can actually click.
#   PAYMENT_GATEWAY=stripe  real Stripe Checkout; needs both keys below.
#   unset                   dummy in debug builds, none in release — a release
#                           build with no gateway explains that card payment is
#                           unavailable rather than pretending to take money.
PAYMENT_GATEWAY=dummy

# Only read when PAYMENT_GATEWAY=stripe. Absence is treated as "feature off",
# never as an empty-string default — the secret key is a bearer credential for
# the whole Stripe account.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- public URLs
# Where a BROWSER can reach this API — used for the card-checkout redirect and
# for links in email. Handed to a client, never fetched by us, so it must be an
# address that client can actually route to.
#
# Unset, it falls back to the bound address (127.0.0.1 when SERVER_HOST is
# 0.0.0.0). That is right for a browser on this machine and WRONG for a phone,
# where 127.0.0.1 is the phone: "Pay" then opens a dead page. Set your LAN
# address when testing on hardware, e.g. http://192.168.1.5:8080
# PUBLIC_BASE_URL=

# Where an emailed link should land — the APP, not the API. Defaults to
# PUBLIC_BASE_URL, which is correct for the same-origin demo.
# LINK_BASE_URL=
