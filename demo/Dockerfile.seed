# Fills the demo with people, programmes, workout history, plans and invoices.
#
# The seed talks to the running API over HTTP rather than writing to the
# database directly, so invitations, capacity grants and the audit trail are all
# genuinely exercised — the demo data is real data, produced the way a real gym
# would produce it.
#
# Debian rather than Alpine on purpose: the script uses GNU `date -d "-1 month"`
# to back-date history, which BusyBox's date does not support.
FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/seed-demo.sh /app/seed-demo.sh

# Belt and braces alongside .gitattributes: a tree cloned before that file
# existed, or with core.autocrlf=true, carries CRLF line endings, and bash
# here reads the trailing CR as part of each token:
#
#   set: pipefail: invalid option name
#   syntax error near unexpected token `$'do\r''
#
# The seed then exits 2, and `web` waits on this container completing, so
# the whole demo never comes up. Cheap to strip, expensive to diagnose.
RUN sed -i 's/\r$//' /app/seed-demo.sh

ENTRYPOINT ["bash", "/app/seed-demo.sh"]
